{
    "name": "EvolverSimple",
    "api_url": "https://fed.fasttrade.dev/api/webhook/evolve",
    "predefined_sets": {
      "columns": ["close", "open", "low", "high"],
      "frequencies": ["1Min", "5Min", "15Min", "30Min", "1h", "4h", "8h", "12h"],
      "operators": ["<", ">"],
      "transformers": ["ema", "zlema","sma"]
    },
    "genes": [
      {
        "name": "freq",
        "type": "categorical",
        "values_ref": "frequencies",
        "args": []
      },
      {
        "name": "sma_transformer",
        "type": "categorical",
        "values_ref": "transformers",
        "args": []
      },
      {
        "name": "sma_args",
        "type": "int",
        "args": [1, 300]
      },
      {
        "name": "sma_column",
        "type": "categorical",
        "values_ref": "columns",
        "args": []
      }
    ],
    "strategy": {
        "freq": "#freq",
        "enter": [
          ["close", ">", "sma_100"]
        ],
        "exit": [
          ["close", "<", "sma_100"]
        ],
        "datapoints": [
          {
            "name": "sma_100",
            "transformer": "#sma_transformer",
            "args": ["#sma_args","#sma_column"]
          }
        ],
        "base_balance": 1000.0,
        "exit_on_end": false,
        "comission": 0.01,
        "trailing_stop_loss": 0.0,
        "lot_size_perc": 1.0,
        "max_lot_size": 0.0,
        "start_date": "2024-01-27T00:00:00",
        "end_date": "2025-03-27T00:00:00",
        "rules": null,
        "symbol": "BTCUSDT",
        "exchange": "binanceus",
        "completed_at": null
    },
    "config": {
        "num_generations": 10,
        "parallel_processing": 8,
        "use_parallel": false,
        "sol_per_pop": 100,
        "num_parents_mating": 3,
        "mutation_percent_genes": 60,
        "crossover_type": "uniform",
        "mutation_type": "adaptive",
        "parent_selection_type": "roulette",
        "K_tournament": 2,
        "elitism": 1,
        "diversity_threshold": 0.6,
        "stagnation_threshold": 20,
        "early_stopping_patience": 50,
        "min_improvement": 0.001
    },
    "fitness":{
      "return_perc": 1
    }
}
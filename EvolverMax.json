{
    "name": "EvolverMax",
    "api_url": "https://fed.fasttrade.dev/api/webhook/evolver",
    "predefined_sets": {
      "columns": ["close", "open", "low", "high","volume"],
      "frequencies": ["1Min", "5Min", "10Min", "15Min", "30Min","45Min", "1h", "2h", "4h", "8h"],
      "operators": ["<", ">"],
      "transformers": ["sma", "ema", "zlema"]
    },
    "genes": [
      {
        "name": "freq",
        "type": "categorical",
        "values_ref": "frequencies",
        "args": []
      },
      {
        "name":"rsi_overbought",
        "type":"int",
        "args":[65,95]
      },
      {
        "name":"rsi_oversold",
        "type":"int",
        "args":[1,64]
      },
      {
        "name":"rsi_overbought_lookback",
        "type":"int",
        "args":[1,3]
      },
      {
        "name":"rsi_oversold_lookback",
        "type":"int",
        "args":[1,3]
      },
      {
        "name": "rsi_period",
        "type": "int",
        "args": [
          2,
          30
        ]
      },
      {
        "name":"zlema_period",
        "type":"int",
        "args":[2,30]
      },
      {
        "name": "start_end_date",
        "type": "date",
        "args": ["2025-08-01", "2025-08-10", 7, 14]
      }
    ],
    "strategy": {
        "freq": "#freq",
        "enter": [
          ["rsi",">","#rsi_overbought","#rsi_overbought_lookback"]
        ],
        "exit": [["rsi","<","#rsi_oversold","#rsi_oversold_lookback"]],
        "datapoints": [
          {"name":"rsi","transformer":"rsi","args":["#rsi_period"]},
          {"name":"zlema","transformer":"zlema","args":["#zlema_period"]}
        ],
        "base_balance": 1000.0,
        "exit_on_end": false,
        "comission": 0.01,
        "trailing_stop_loss": 0.0,
        "lot_size_perc": 1.0,
        "max_lot_size": 0.0,
        "start_date": "2025-08-16T00:00:00",
        "end_date": "2025-08-18T00:00:00",
        "rules": null,
        "symbol": "BTC-USD",
        "exchange": "coinbase",
        "completed_at": null
  },
    "config": {
      "num_generations": 200,
      "parallel_processing": 4,
      "use_parallel": true,
      "sol_per_pop": 200,
      "num_parents_mating": 3,
      "mutation_percent_genes": 0.8,
      "crossover_type": "uniform",             
      "mutation_type": "adaptive", 
      "parent_selection_type": "roulette",
      "K_tournament": 2,
      "elitism": 1,
      "diversity_threshold": 0.6,
      "stagnation_threshold": 20,
      "early_stopping_patience": 50,
      "min_improvement": 0.001,
      "refresh_percent": 0.6
  },
    "fitness":{
      "sharpe_ratio": 1,
      "win_rate": 1
    }
}
